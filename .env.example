# ========================================================
# FIREBASE SOZLAMALARI NAMUNASI (.env.example)
# ========================================================
# Haqiqiy loyihada ushbu fayldan nusxa olib, '.env.local' faylini yarating
# va qiymatlarni o'zingizning Firebase loyihangizdan to'ldiring.

# Vite uchun (OrdersApp da standart):
VITE_FIREBASE_API_KEY=AIzaSyD-namuna-kalit-bu-yerda
VITE_FIREBASE_AUTH_DOMAIN=orders-app-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orders-app-demo
VITE_FIREBASE_STORAGE_BUCKET=orders-app-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=109283746501
VITE_FIREBASE_APP_ID=1:109283746501:web:98a7b6c5d4e3f210

# Next.js uchun (agar Next.js ishlatilsa):
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD-namuna-kalit-bu-yerda
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=orders-app-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=orders-app-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=orders-app-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109283746501
NEXT_PUBLIC_FIREBASE_APP_ID=1:109283746501:web:98a7b6c5d4e3f210
